{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Coincover Developer Docs",
  "colors": {
    "primary": "#3939EF",
    "light": "#B59BFD",
    "dark": "#B59BFD"
  },
  "contextual": {
    "options": ["copy", "view", "claude", "cursor"],
    "display": "header"
  },
