        "groups": [
          {
            "group": "Keys",
            "icon": "key",
            "pages": ["guides/validating-key-signatures"]
          },
          {
            "group": "Using CoinCover Control",
            "icon": "sliders",
            "pages": [
              "guides/control/get-started",
              "guides/control/approval-control-list",
              "guides/control/approve-list-change",
              "guides/control/recover-key-material",
              "guides/control/create-gpg-key",
              "guides/control/approve-recovery-request",
              "guides/vault-sync"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API Reference",
            "pages": [
              {
                "group": "Wallet Provider API",
                "openapi": "specs/wallet-provider.openapi.json"
              },
              {
                "group": "Institutional API",
                "openapi": "specs/institutional.openapi.json"
              },
              {
                "group": "Retail API",
                "openapi": "specs/retail.openapi.json"
              },
              {
                "group": "Updates",
                "pages": ["changelog/changelog"]
              }
            ]
          }
        ]
