  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Talk to us",
      "href": "https://www.coincover.com/contact"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/coincoverglobal/",
      "x": "https://x.com/Coincoverglobal",
      "website": "https://www.coincover.com"
    }
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#0E171B"
    }
  },
  "fonts": {
    "family": "Inter",
    "weight": 400,
    "heading": {
      "family": "Inter",
      "weight": 400
    },
    "body": {
      "family": "Space Grotesk",
      "weight": 400
