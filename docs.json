              "institutional-recovery/add-a-backup-key",
              "institutional-recovery/cli-integration-guide",
              "institutional-recovery/cli-reference",
              "institutional-recovery/testing"
            ]
          },
          {
            "group": "Retail Recovery",
            "pages": [
              "retail-recovery/overview",
              "retail-recovery/integration-guide",
              "retail-recovery/ui-components",
              "retail-recovery/testing"
            ]
          }
        ]
      },
      {
        "tab": "Partners",
        "pages": [
          "partner-guides/overview",
          "partner-guides/bitgo",
          "partner-guides/fireblocks",
          "partner-guides/utila",
          "partner-guides/fordefi",
          "partner-guides/copper"
